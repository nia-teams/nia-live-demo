# Copy to .env at the repo root. The server reads this file; the browser never
# sees any of it. For CLIProxyAPI usage (and proxy setup if needed), refer to
# https://github.com/router-for-me/CLIProxyAPI

CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
CLIPROXY_API_KEY=

# ── Optional (defaults shown) ────────────────────────────────────────────────
# The persona lives in server/prompts/{instructions,greeting}.md — edit those
# files to change who the companion is and how it opens.
#
# CLIPROXY_WS_URL=ws://127.0.0.1:8317/v1
# GPT_LIVE_MODEL=gpt-live-1-codex
# GPT_LIVE_VOICE=maple                 # maple, cedar, coral, sage, verse
# GPT_LIVE_RESPONSES_MODEL=gpt-6.1-sol # gpt-6.1-sol or gpt-6-astra
#
# `ultrafast` requires a ChatGPT Pro ($500/mo) subscription.
# For non-$500 tiers (e.g. $200 Pro / Plus), set GPT_LIVE_SERVICE_TIER=default or priority.
# GPT_LIVE_SERVICE_TIER=ultrafast
#
# GPT_LIVE_DEBUG=1                     # log every GPT-Live event (audio elided)
# HOST=0.0.0.0
# PORT=8787
